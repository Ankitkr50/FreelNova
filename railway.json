{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd server && npm install && npm run build"
  },
  "deploy": {
    "startCommand": "cd server && npm run start:prod",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 180
  }
}

